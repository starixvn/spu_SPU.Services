<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
  </startup>
  <appSettings>

    <add key="Queue-Host" value="10.2.23.1"/>
    <add key="Queue-Port" value="5672"/>
    <add key="Queue-VirtualHost" value="/FPS_Oneye_Service"/>
    <add key="Queue-UserName" value="fpsadmin"/>
    <add key="Queue-Password" value="fps@dm!n123"/>
    <add key="Queue-PrefetchCount" value="1"/>
    <add key="Queue-Exchange" value="fpstransExchange"/>
    <add key="Queue-Name" value="newfpstransQueue"/>
    <add key="Queue-RoutingKey" value="fpstransMessage"/>

    <add key="Trans-Batch" value="1000000"/>

