<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
  <appSettings>
    <add key="Queue-Host" value="ha.nexdev.net" />
    <add key="Queue-Port" value="5672" />
    <add key="Queue-VirtualHost" value="/FPS_Oneye_Service" />
    <add key="Queue-UserName" value="fps" />
    <add key="Queue-Password" value="fps" />
    <add key="Queue-PrefetchCount" value="1" />
    <add key="Queue-Exchange" value="fpstransExchange" />
    <add key="Queue-Name" value="ctsTransQueue" />
    <add key="Queue-RoutingKey" value="fpstransMessage" />

    <add key="Trans-Batch" value="100" />

  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.8.0" newVersion="2.0.8.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>