@using Fanex.NAP.SPU.Main.Features.JobSchedulers.ViewModels;
@model IEnumerable<GroupJobModel>

@{
    ViewData["Title"] = "Updated Jobs";
}

<div class="group-info">
    <input id="btnSaveUpdateJobs" type="button" title="Save Update Jobs" value="Save Update" onclick="if (confirm('Are you sure?')) { location.href = '@Url.Action("SaveUpdateJobs", "Scheduler")' } ">
</div>

<table class="table-job" cellpadding="2" cellspacing="2">
    <tr class="table-job-tr-header">
        <td width="50" style="text-align:center"></td>
        <td class="table-job-td-header">
            <span>Job Name</span>
        </td>
        <td class="table-job-td-header">
            <span>Job Type</span>
        </td>
        <td class="table-job-td-header">
            <span>APIUrl</span>
        </td>
        <td class="table-job-td-header" style="width:60px">
            <span>IsActive</span>
        </td>
    </tr>

    @if (Model != null && Model.Any())
    {
        @foreach (var groupJob in Model)
        {
            @foreach (var job in groupJob.Jobs)
            {
                <tr class="table-job-tr-body" style="background-color: @(job.UpdateStatus == UpdateStatus.Update ? "#FFFF00" : "#FFFFFF")">
                    <td class="td-body">
                        <img src="~/Images/toggle.png" />
                    </td>
                    <td class="table-job-td-body">
                        <span>@job.JobName</span>
                    </td>
                    <td class="table-job-td-body">
                        <span>
                            @job.JobType
                        </span>
                    </td>
                    <td class="table-job-td-body">
                        <span>@job.APIUrl</span>
                    </td>
                    <td class="table-job-td-body">
                        <span>@job.IsActive</span>
                    </td>
                </tr>

                <tr>
                    <td colspan="5">
                        <table class="table-trigger">
                            <tr class="table-trigger-tr-header">
                                <td width="60px" class="table-trigger-td-header">
                                    <img src="~/Images/toggle.png" />
                                </td>
                                <td class="table-trigger-td-header">
                                    <span>Trigger Type</span>
                                </td>
                                <td class="table-trigger-td-header">
                                    <span>Trigger Name</span>
                                </td>
                                <td class="table-trigger-td-header">
                                    <span>Repeat Forever</span>
                                </td>
                                <td class="table-trigger-td-header">
                                    <span>Cron Expression</span>
                                </td>
                            </tr>

                            @foreach (var trigger in job.Triggers)
                            {
                                <tr style="background-color: @(trigger.UpdateStatus == UpdateStatus.Update ? "#FFFF00" : "#FFFFFF")">
                                    <td></td>
                                    <td class="table-trigger-td-body">
                                        <span style="color:#000000">
                                            @trigger.TriggerType
                                        </span>
                                    </td>
                                    <td class="table-trigger-td-body">
                                        <span style="color:#000000">
                                            @trigger.TriggerName
                                        </span>
                                    </td>
                                    <td class="table-trigger-td-body">
                                        <span style="color:#000000">
                                            @trigger.RepeatForever
                                        </span>
                                    </td>
                                    <td class="table-trigger-td-body">
                                        <span style="color:#000000">
                                            @trigger.CronExpression
                                        </span>
                                    </td>
                                </tr>
                            }

                        </table>
                    </td>
                </tr>
            }
        }
    }

</table>
