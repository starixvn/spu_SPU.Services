@using Fanex.NAP.SPU.Main.Features.JobSchedulers.ViewModels.Job;
@model UpdateJobViewModel

@{
    ViewData["Title"] = "Updated Jobs";
}

<p>Successfully</p>

<div>
    @if (Model.NewList.Any())
    {
        <table class="table table-responsive table-hover">
            <thead>
                <tr><td colspan="4"><h5>New Job</h5></td></tr>
            </thead>
            <tbody>
                @foreach (JobScheduleViewModel job in Model.NewList)
                {
                    <tr>
                        <td>JobName</td>
                        <td>@job.JobName</td>
                    </tr>
                    <tr>
                        <td>JobType</td>
                        <td>@job.JobType</td>
                    </tr>
                    <tr>
                        <td>APIUrl</td>
                        <td>@job.APIUrl</td>
                    </tr>
                    <tr>
                        <td>IsActive</td>
                        <td>@job.IsActive</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.UpdatedList.Any()) { 
        <table class="table table-responsive table-hover">
            <thead>
                <tr><td colspan="4"><h5>Updated Job</h5></td></tr>
            </thead>
            <tbody>
                @foreach (JobScheduleViewModel job in Model.UpdatedList)
                {
                    <tr>
                        <td>JobName</td>
                        <td>@job.JobName</td>
                    </tr>
                    <tr>
                        <td>JobType</td>
                        <td>@job.JobType</td>
                    </tr>
                    <tr>
                        <td>APIUrl</td>
                        <td>@job.APIUrl</td>
                    </tr>
                    <tr>
                        <td>IsActive</td>
                        <td>@job.IsActive</td>
                    </tr>
                }
            </tbody>
        </table>

    }

    @if (Model.DeletedList.Any()) {
        <table class="table table-responsive table-hover">
            <thead>
                <tr><td colspan="4"><h5>Deleted Job</h5></td></tr>
            </thead>
            <tbody>
                @foreach (JobScheduleViewModel job in Model.DeletedList)
                {
                    <tr>
                        <td>JobName</td>
                        <td>@job.JobName</td>
                    </tr>
                    <tr>
                        <td>JobType</td>
                        <td>@job.JobType</td>
                    </tr>
                    <tr>
                        <td>APIUrl</td>
                        <td>@job.APIUrl</td>
                    </tr>
                    <tr>
                        <td>IsActive</td>
                        <td>@job.IsActive</td>
                    </tr>
                }
            </tbody>
        </table>    
    }   
    
</div>
