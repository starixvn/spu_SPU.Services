<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ output extension=".bat" encoding="us-ascii" #>
<#string folderPath = Host.ResolveAssemblyReference("$(ProjectDir)") + @"bin\debug\";
if(!Directory.Exists(folderPath))
{
	folderPath = Host.ResolveAssemblyReference("$(ProjectDir)") + @"bin\release\";
}
string[] filePaths = Directory.GetFiles(folderPath, "*.exe", SearchOption.TopDirectoryOnly);#>
<#foreach(var file in filePaths){#>
<#="c:"#>
<#="taskkill /f /im " + Path.GetFileName(file)#>
<#}#>