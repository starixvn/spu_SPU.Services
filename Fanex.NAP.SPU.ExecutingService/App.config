    <add key="Log-SentryLogging-Config" value="https://95587e38aa44413094c39b488d4f8425@sentry.nexdev.net/33" />
    <add key="Fanex.Log.Category" value="ExecutingService-LOCAL" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />

    <add key="Auth-Domain" value="SPVN" />
    <add key="Auth-Groups" value="" />
    
    <add key="VS-JobCronEveryDay" value="0 15 0 * * ?" />

    <add key="cluster-key" value="Master"/>
    <add key="MaxCustIdForHealing" value="44728786"/>
    
  </appSettings>
