    <add key="quartz.serializer.type" value="json" />
    <add key="quartz.plugin.xml.type" value="Quartz.Plugin.Xml.XMLSchedulingDataProcessorPlugin, Quartz.Plugins" />
    <add key="quartz.plugin.xml.fileNames" value="~/App_Data/Jobs.xml" />
    <add key="quartz.plugin.xml.failOnFileNotFound" value="true" />
    <add key="quartz.plugin.xml.failOnSchedulingError" value="true" />
    <add key="quartz.plugin.xml.scanInterval" value="60" />
  </quartz>
