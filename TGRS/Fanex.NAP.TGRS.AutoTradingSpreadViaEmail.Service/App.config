<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
	</startup>
	<appSettings>
		<add key="Environment" value="1" />
		<add key="Log-SentryLogging-Config" value="https://95587e38aa44413094c39b488d4f8425@sentry.nexdev.net/33"/>
		<add key="Log-SentryLogging-Category" value="TGRS"/>
		<add key="TGRS-AutoTrading-API-BaseAddress" value="http://ha.nexdev.net:7724/TGRS/" />
		<add key="TGRS-AutoTrading-File-Password" value="Star168" />
	</appSettings>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<Fanex.MailDelivery.Client applicationSendMailId="1"
							   siteId="85"
							   rabbitMQConnectionString="host=ha.nexdev.net:5672;virtualHost=/MailStationHost;username=rabbitclient;timeout=3600">
		<Functions>
			<!--<add id="1" name="YourFunction" />-->
		</Functions>
		<Schedules>
			<Schedule id="346" name="Automail Report - Model TA Performance Event Details" job="Fanex.NAP.TGRS.AutoTradingViaEmail.Service.SendMailJob, Fanex.NAP.TGRS.AutoTradingViaEmail.Service" />
		</Schedules>
	</Fanex.MailDelivery.Client>
</configuration>
