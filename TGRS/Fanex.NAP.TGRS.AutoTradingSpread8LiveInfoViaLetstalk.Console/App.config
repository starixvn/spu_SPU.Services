<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
	</startup>
	<appSettings>
		<add key="Environment" value="1" />
		<add key="Log-SentryLogging-Config" value="https://95587e38aa44413094c39b488d4f8425@sentry.nexdev.net/33" />
		<add key="Log-SentryLogging-Category" value="TGRS" />
		<add key="LetstalkServiceApi" value="http://letstalk-webapi.playthefun.com/" />
		<add key="TGRS-AutoTrading-Letstalk-Target" value="TGR-Auto-Trading" />
		<add key="TGRS-AutoTrading-Letstalk-Group" value="TGR-Auto-Trading-Test;TGR-Auto-Trading-Test" />
		<add key="TGRS-AutoTrading-SpecicalDateExecute" value="" />
		<!-- SpecicalDateExecute format: MM/dd/yyyy -->
		<add key="TGRS-AutoTrading-API-BaseAddress" value="http://localhost:57579/TGRS/" />
	</appSettings>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>