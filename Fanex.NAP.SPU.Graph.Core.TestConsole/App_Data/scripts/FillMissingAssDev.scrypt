MATCH (n:ScanAssDev)
WITH "jdbc:mysql://10.40.40.58:3306/CTS_DataCenter?user=harvey.vn&password=harvey@1234" as url, n.CTSAssDevID as lastCTSAssDevID
CALL apoc.load.jdbcParams(url,"select * from CTS_Log.Monitor_Neo4j_AssByDevice_Missing mass
where CTSAssDevID > ?
order by CTSAssDevID
limit 1000", [lastCTSAssDevID]) YIELD row

MATCH (c:CTSCustomer {CTSCustID:toInteger(row.CTSCustID)})
MERGE (n:Device {DeviceID:toInteger(row.DCSDeviceID)})
MERGE (c)-[r:USED_DEVICE]->(n)
ON CREATE SET r.CreatedDate = datetime(row.CreatedDate)

WITH MAX(toInteger(row.CTSAssDevID)) as maxCTSAssDevID
MATCH (n:ScanAssDev)
SET n.CTSAssDevID = maxCTSAssDevID